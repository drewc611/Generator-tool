<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Ledger.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignHeight="320" d:DesignWidth="420"
        Title="Log in" Height="320" Width="420" Loaded="Window_Loaded">
  <Window.Resources>
    <Style x:Key="FieldStyle" TargetType="TextBox">
      <Setter Property="Margin" Value="4"/>
    </Style>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open..." Click="Open_Click" InputGestureText="Ctrl+O"/>
        <Separator/>
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About" Click="About_Click" IsEnabled="False"/>
      </MenuItem>
    </Menu>
    <Grid Margin="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <!-- The field is written before its label; the grid, not the file, says which comes first. -->
      <TextBox Grid.Row="0" Grid.Column="1" x:Name="UserNameBox" Text="{Binding UserName}" Style="{StaticResource FieldStyle}"/>
      <Label Grid.Row="0" Grid.Column="0" Content="_User name:" Target="{Binding ElementName=UserNameBox}"/>
      <Label Grid.Row="1" Grid.Column="0" Content="Password:"/>
      <PasswordBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldStyle}"/>
      <CheckBox Grid.Row="2" Grid.Column="1" Content="_Remember me" IsChecked="{Binding RememberMe}"/>
      <GroupBox Grid.Row="3" Grid.ColumnSpan="2" Header="Role">
        <StackPanel Orientation="Horizontal">
          <RadioButton Content="_Clerk" GroupName="Role" IsChecked="True"/>
          <RadioButton Content="_Manager" GroupName="Role"/>
        </StackPanel>
      </GroupBox>
      <Label Grid.Row="4" Grid.Column="0" Content="Region"/>
      <ComboBox Grid.Row="4" Grid.Column="1" x:Name="RegionBox" SelectedItem="{Binding Region}">
        <ComboBoxItem Content="North"/>
        <ComboBoxItem>South &amp; East</ComboBoxItem>
      </ComboBox>
      <Label Grid.Row="5" Grid.Column="0" Content="Branch"/>
      <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Branches}" SelectedItem="{Binding Branch}" DisplayMemberPath="Name"/>
      <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="Locked out" Foreground="Red" Visibility="Collapsed"/>
      <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="{Binding Status}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
      <TextBox Grid.Row="8" Grid.ColumnSpan="2" x:Name="NotesBox" AcceptsReturn="True" IsReadOnly="True" Text="{Binding Notes, Mode=OneWay}"/>
      <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Help" Click="Help_Click" IsEnabled="False"/>
        <Button Content="Log in" IsDefault="True" Click="Login_Click" IsEnabled="{Binding CanLogin}"/>
        <Button Content="Cancel" IsCancel="True"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
