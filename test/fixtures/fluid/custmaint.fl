# data file for the Fltk User Interface Designer (fluid)
version 1.0400
header_name {.h}
code_name {.cxx}

Function {make_window()} {open
} {
  Fl_Window custWindow {
    label {Customer Maintenance}
    xywh {100 100 400 340} visible
  } {
    Fl_Input custName {
      label {Name:}
      xywh {120 20 200 25}
    }
    Fl_Check_Button activeFlag {
      label {Active}
      xywh {120 60 200 25}
    }
    Fl_Group radioGroup {
      xywh {120 100 200 50}
    } {
      Fl_Round_Button planBasic {
        label {Basic}
        xywh {120 100 90 25}
      }
      Fl_Round_Button planPro {
        label {Pro}
        xywh {220 100 90 25}
      }
    }
    Fl_Button okButton {
      label {OK}
      callback {handleOk(o,v);}
      xywh {120 220 80 25}
    }
    Fl_Button {} {
      label {Cancel}
      callback {counter++;}
      xywh {220 220 80 25}
    }
  }
}
