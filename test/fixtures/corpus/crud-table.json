{
  "label": "crud-table",
  "html": "<table><tr *ngFor=\"let o of orders\"><td>{{o.id}}</td><td><button (click)=\"remove(o)\">Delete</button></td></tr></table>",
  "calls": [
    {
      "method": "GET",
      "path": "/api/orders"
    },
    {
      "method": "POST",
      "path": "/api/orders"
    },
    {
      "method": "DELETE",
      "path": "/api/orders/${id}"
    }
  ]
}
