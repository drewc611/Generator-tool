{
  "label": "chat",
  "html": "<ul><li *ngFor=\"let m of messages\">{{m.text}}</li></ul><form (submit)=\"send()\"><input [(ngModel)]=\"draft\" placeholder=\"Message\"><button type=\"submit\">Send</button></form>",
  "calls": [
    {
      "method": "GET",
      "path": "/api/messages"
    },
    {
      "method": "POST",
      "path": "/api/messages"
    }
  ]
}
