{
  "label": "search-and-filter",
  "html": "<input [(ngModel)]=\"q\" placeholder=\"Search products\"><select [(ngModel)]=\"category\"></select><ul><li *ngFor=\"let p of results\">{{p.name}}</li></ul>",
  "calls": [
    {
      "method": "GET",
      "path": "/api/products?q=term&category=x&sort=asc"
    }
  ]
}
